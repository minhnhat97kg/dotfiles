{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "layer-shell": true,
  "control-center-layer": "top",
  "control-center-width": 460,
  "control-center-height": 500,
  "control-center-exclusive-zone": true,
  "fit-to-screen": true,
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-window-width": 420,
  "notification-window-height": -1,
  "image-visibility": "never",
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "notification-grouping": true,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "-- no notifications --",
  "script-fail-notify": true,
  "cssPriority": "user",
  "ignore-gtk-theme": true,
  "widgets": [
    "title",
    "notifications",
    "mpris",
    "buttons-grid#actions"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "[ Clear All ]"
    },
    "notifications": {
      "vexpand": true
    },
    "mpris": {
      "show-album-art": "never",
      "autohide": true,
      "loop-carousel": false,
      "blacklist": []
    },
    "buttons-grid#actions": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "[ ] Do Not Disturb",
          "type": "normal",
          "command": "$HOME/.config/swaync/scripts/toggle.sh dnd toggle"
        },
        {
          "label": "[ ] Wifi",
          "type": "normal",
          "command": "$HOME/.config/swaync/scripts/toggle.sh wifi toggle"
        },
        {
          "label": "[ ] Bluetooth",
          "type": "normal",
          "command": "$HOME/.config/swaync/scripts/toggle.sh bluetooth toggle"
        },
        {
          "label": "[Lock]",
          "type": "normal",
          "command": "loginctl lock-session"
        },
        {
          "label": "[Suspend]",
          "type": "normal",
          "command": "systemctl suspend"
        }
      ]
    }
  }
}
