;; Home-row mods + a space-hold navigation layer, plus the original
;; Caps = tap:Escape / hold:Control.
;;
;; Home-row mods (based on kanata's cfg_samples/home-row-mod-advanced.kbd):
;;   hold a/s/d/f = Super/Alt/Ctrl/Shift   (left hand)
;;   hold j/k/l/; = Shift/Ctrl/Alt/Super   (right hand)
;; Anti-misfire: when a mod key resolves as a tap, mods are briefly disabled
;; (the `nomods` layer) so fast rolls type letters instead of firing modifiers;
;; an idle fake-key flips back to `base`. `tap-hold-release-keys` with the
;; same-hand key list also makes same-hand rolls tap early.
;;
;; Nav layer: hold Space to turn h/j/k/l into arrows and u/i/o/p into
;; Home/End/PgUp/PgDn. A tap of Space is still Space.

(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps
  a s d f  h j k l ;
  u i o p
  spc
)

(defvar
  tap-time 200
  hold-time 150

  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)

(deffakekeys
  to-base (layer-switch base)
)

(defalias
  caps (tap-hold-release $tap-time $hold-time esc lctl)

  ;; Disable mods while typing fast, then return to base once idle.
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  a (tap-hold-release-keys $tap-time $hold-time (multi a @tap) lmet $left-hand-keys)
  s (tap-hold-release-keys $tap-time $hold-time (multi s @tap) lalt $left-hand-keys)
  d (tap-hold-release-keys $tap-time $hold-time (multi d @tap) lctl $left-hand-keys)
  f (tap-hold-release-keys $tap-time $hold-time (multi f @tap) lsft $left-hand-keys)
  j (tap-hold-release-keys $tap-time $hold-time (multi j @tap) rsft $right-hand-keys)
  k (tap-hold-release-keys $tap-time $hold-time (multi k @tap) rctl $right-hand-keys)
  l (tap-hold-release-keys $tap-time $hold-time (multi l @tap) ralt $right-hand-keys)
  ; (tap-hold-release-keys $tap-time $hold-time (multi ; @tap) rmet $right-hand-keys)

  ;; Space: tap = Space, hold = navigation layer.
  spc (tap-hold-release $tap-time $hold-time spc (layer-while-held nav))
)

(deflayer base
  @caps
  @a @s @d @f  h @j @k @l @;
  u i o p
  @spc
)

(deflayer nomods
  @caps
  a s d f  h j k l ;
  u i o p
  @spc
)

(deflayer nav
  @caps
  _ _ _ _  left down up right _
  home end pgup pgdn
  spc
)
